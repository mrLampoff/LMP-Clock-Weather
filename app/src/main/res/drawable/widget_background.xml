<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LIGHT BLUE GREY GLASS BODY -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <solid android:color="#8D9EAFBA"/>
        </shape>
    </item>

    <!-- TOP REFLECTION -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#65FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- CONVEX CENTRAL GLOW -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp"/>
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="#48FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- DARKENED LOWER EDGE -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#081B2A38"
                android:endColor="#40233442"/>
        </shape>
    </item>

</layer-list>
