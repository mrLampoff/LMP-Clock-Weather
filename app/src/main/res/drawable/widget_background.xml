<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Основний шар: прозоре блакитно-сіре скло -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="90"
                android:startColor="#3DDFEAF2"
                android:centerColor="#28C8D8E5"
                android:endColor="#45A9BBCB" />
        </shape>
    </item>

    <!-- М'який опуклий відблиск зверху -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient
                android:angle="90"
                android:startColor="#48FFFFFF"
                android:centerColor="#16FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Ледь помітне внутрішнє затемнення знизу -->
    <item
        android:left="1dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient
                android:angle="270"
                android:startColor="#00FFFFFF"
                android:centerColor="#080E2638"
                android:endColor="#25102030" />
        </shape>
    </item>

    <!-- Тонкий внутрішній контур -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <stroke
                android:width="0.5dp"
                android:color="#20FFFFFF" />
        </shape>
    </item>

</layer-list>
