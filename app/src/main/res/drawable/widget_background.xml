<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main transparent blue-grey glass -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <solid android:color="#263E5263"/>
        </shape>
    </item>

    <!-- Wide glossy upper reflection -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#35F4FAFF"
                android:centerColor="#12EAF5FF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- Blue glass edge illumination -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#263F91B5"
                android:centerColor="#003F91B5"
                android:endColor="#263F91B5"/>
        </shape>
    </item>

    <!-- Subtle bottom shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00000000"
                android:centerColor="#0A10202C"
                android:endColor="#30101C29"/>
        </shape>
    </item>

    <!-- Delicate blue-grey glass contour -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <stroke
                android:width="1dp"
                android:color="#203F91B5"/>
        </shape>
    </item>

</layer-list>
