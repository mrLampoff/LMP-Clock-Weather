<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Майже прозора скляна основа -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <solid android:color="#18B9D0E0"/>
        </shape>
    </item>

    <!-- Вузький верхній відблиск -->
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp"/>
            <gradient
                android:angle="90"
                android:startColor="#38FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- Ледь помітний холодний відблиск знизу -->
    <item
        android:left="2dp"
        android:top="3dp"
        android:right="2dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp"/>
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#001B2938"
                android:endColor="#183E5368"/>
        </shape>
    </item>

    <!-- Тонкий внутрішній край -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp"/>
            <stroke
                android:width="1dp"
                android:color="#16FFFFFF"/>
        </shape>
    </item>

</layer-list>
