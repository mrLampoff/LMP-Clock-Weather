
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Основне димчасте скло -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:angle="90"
                android:startColor="#702B3B4D"
                android:centerColor="#5C172432"
                android:endColor="#80101925"/>
        </shape>
    </item>

    <!-- Верхній скляний відблиск -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp"/>
            <gradient
                android:angle="90"
                android:startColor="#32FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- М'яке внутрішнє затемнення знизу -->
    <item
        android:left="1dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp"/>
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#08000000"
                android:endColor="#35101824"/>
        </shape>
    </item>

</layer-list>
