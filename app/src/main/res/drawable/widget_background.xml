<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Transparent blue-grey glass -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <solid android:color="#263E5263"/>
        </shape>
    </item>

    <!-- Upper curved reflection -->
    <item android:height="52dp" android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#38FFFFFF"
                android:centerColor="#16FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- Central glass glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#12FFFFFF"
                android:centerColor="#04FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- Lower depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#080D1D29"
                android:endColor="#28101C29"/>
        </shape>
    </item>

</layer-list>
