<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- HEADER: REFRESH BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#DFFFFFFF"
            android:contentDescription="Оновити погоду"
            android:scaleType="centerInside"
            android:padding="5dp" />

    </LinearLayout>

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <!-- CLOCK SECTION -->
        <LinearLayout
            android:id="@+id/widget_clock_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="74sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="-0.05"
                android:maxLines="1"
                android:singleLine="true" />

            <TextClock
                android:id="@+id/widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:textColor="#DFFFFFFF"
                android:textSize="17sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:id="@+id/widget_city_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌖"
                    android:textColor="#AFFFFFFF"
                    android:textSize="18sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_city"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Десна"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- VERTICAL DIVIDER -->
        <View
            android:layout_width="1dp"
            android:layout_height="94dp"
            android:background="#45FFFFFF"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="10dp" />

        <!-- WEATHER SECTION -->
        <LinearLayout
            android:id="@+id/widget_weather_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:orientation="vertical"
            android:gravity="center_vertical|end">

            <!-- ICON + TEMPERATURE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <TextView
                    android:id="@+id/widget_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀"
                    android:textColor="#FFFFFFFF"
                    android:textSize="46sp"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/widget_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="#FFFFFFFF"
                    android:textSize="62sp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04" />

            </LinearLayout>

            <TextView
                android:id="@+id/widget_high_low"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="↑ --°  ↓ --°"
                android:textColor="#DFFFFFFF"
                android:textSize="15sp"
                android:gravity="end"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Завантаження..."
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
