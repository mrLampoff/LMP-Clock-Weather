<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LMP WEATHER"
            android:textColor="#C8FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#DFFFFFFF"
            android:contentDescription="Оновити погоду"
            android:scaleType="centerInside"
            android:padding="6dp" />

    </LinearLayout>

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp">

        <!-- CLOCK SECTION -->
        <LinearLayout
            android:id="@+id/widget_clock_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="43sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04" />

            <TextClock
                android:id="@+id/widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:textColor="#BFFFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="5dp" />

            <LinearLayout
                android:id="@+id/widget_city_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌖"
                    android:textColor="#AFFFFFFF"
                    android:textSize="14sp"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/widget_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Десна"
                    android:textColor="#DFFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- VERTICAL DIVIDER -->
        <View
            android:layout_width="1dp"
            android:layout_height="76dp"
            android:background="#35FFFFFF"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp" />

        <!-- WEATHER SECTION -->
        <LinearLayout
            android:id="@+id/widget_weather_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:orientation="vertical"
            android:gravity="center_vertical|end">

            <TextView
                android:id="@+id/widget_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀"
                android:textColor="#FFFFFFFF"
                android:textSize="27sp"
                android:includeFontPadding="false"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="#FFFFFFFF"
                android:textSize="37sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_high_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ --°  ↓ --°"
                android:textColor="#BFFFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Завантаження..."
                android:textColor="#DFFFFFFF"
                android:textSize="10sp"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
