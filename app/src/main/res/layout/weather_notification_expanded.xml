<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/notification_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LMP Weather"
        android:textColor="#202124"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/notification_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4°"
            android:textColor="#202124"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_daily"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:text="Мін. 0° · Макс. 7°"
            android:textColor="#555555"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/notification_forecast_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:text="ПОГОДИННИЙ ПРОГНОЗ"
        android:textColor="#666666"
        android:textSize="10sp"
        android:letterSpacing="0.12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="6">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/forecast_time_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="12:00"
                android:textColor="#555555"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/forecast_rain_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:text="40%"
                android:textColor="#555555"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/forecast_icon_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="🌧️"
                android:textSize="19sp" />
            <TextView
                android:id="@+id/forecast_temp_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="4°"
                android:textColor="#202124"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/forecast_time_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="13:00"
                android:textColor="#555555"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/forecast_rain_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:text="40%"
                android:textColor="#555555"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/forecast_icon_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="🌧️"
                android:textSize="19sp" />
            <TextView
                android:id="@+id/forecast_temp_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="4°"
                android:textColor="#202124"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/forecast_time_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="14:00"
                android:textColor="#555555"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/forecast_rain_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:text="40%"
                android:textColor="#555555"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/forecast_icon_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="🌧️"
                android:textSize="19sp" />
            <TextView
                android:id="@+id/forecast_temp_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="4°"
                android:textColor="#202124"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/forecast_time_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="15:00"
                android:textColor="#555555"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/forecast_rain_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:text="40%"
                android:textColor="#555555"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/forecast_icon_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="🌧️"
                android:textSize="19sp" />
            <TextView
                android:id="@+id/forecast_temp_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="4°"
                android:textColor="#202124"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/forecast_time_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="16:00"
                android:textColor="#555555"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/forecast_rain_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:text="40%"
                android:textColor="#555555"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/forecast_icon_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="🌧️"
                android:textSize="19sp" />
            <TextView
                android:id="@+id/forecast_temp_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="4°"
                android:textColor="#202124"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/forecast_time_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="17:00"
                android:textColor="#555555"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/forecast_rain_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:text="40%"
                android:textColor="#555555"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/forecast_icon_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="🌧️"
                android:textSize="19sp" />
            <TextView
                android:id="@+id/forecast_temp_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="3dp"
                android:text="4°"
                android:textColor="#202124"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
